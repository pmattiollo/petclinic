    },
    {
      "type": "timeseries",
      "id": 202,
      "title": "5xx by route \u2014 server faults",
      "description": "Every repository call in the controllers ends in .orElseThrow(), and several write paths are NOT @Transactional (VisitRestController.addVisit/updateVisit), so a lazy load can escape its session. Both surface here as 500s, i.e. as a bug, not as a client error.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "legendFormat": "{{http_response_status_code}} {{http_route}}",
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_response_status_code=~\"5..\"}[$__rate_interval]))"
        }
      ],
      "options": {
        "legend": {
