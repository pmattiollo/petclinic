            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_response_status_code!~\"5..\"}[$__rate_interval]))\n/\nclamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"$service\"}[$__rate_interval])), 0.0001)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
