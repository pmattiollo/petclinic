    {
      "type": "timeseries",
      "id": 303,
      "title": "Connection hold time (p95 / p99)",
      "description": "How long a borrowed connection is kept. A long tail here \u2014 not a slow query \u2014 is what exhausts a 10-connection pool: a transaction held open across slow application work (LLM round-trip, elicitation, mapping a large object graph).",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
