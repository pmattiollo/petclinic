    {
      "type": "timeseries",
      "id": 302,
      "title": "Pool connections: in use vs idle vs max",
      "description": "'used' touching 'max' is the saturation point. The MCP tools are @Transactional and call_vet_ambulance blocks on a human answering an elicitation prompt (spring.ai.mcp.server.request-timeout=120s) \u2014 a handful of those can pin the whole pool.",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "legendFormat": "{{state}}",
          "expr": "sum by (state) (db_client_connections_usage{service_name=\"$service\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "legendFormat": "max",
          "expr": "max(db_client_connections_max{service_name=\"$service\"})"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
