    {
      "type": "timeseries",
      "id": 501,
      "title": "Commits vs rollbacks",
      "description": "Rollbacks are the DB-side view of failed writes. Because most write controllers lack @Transactional, a partially-applied multi-step change shows up as commits WITHOUT a rollback \u2014 so a flat rollback line next to 5xx spikes is itself a finding.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
