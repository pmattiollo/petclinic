          "expr": "sum(rate(postgresql_commits_total[$__rate_interval]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "legendFormat": "rollbacks",
          "expr": "sum(rate(postgresql_rollbacks_total[$__rate_interval]))"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
