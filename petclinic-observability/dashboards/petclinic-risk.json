          "legendFormat": "{{http_request_method}} {{http_response_status_code}}",
          "expr": "sum by (http_request_method, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"$service\", http_route=\"/mcp\"}[$__rate_interval]))"
